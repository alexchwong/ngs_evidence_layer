{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/ngs_evidence_layer/quote_schema.json",
  "title": "Quote file paired to one card file",
  "description": "Never distributed and never returned by retrieval. Exists for audit and hallucination checking only.",
  "type": "object",
  "required": ["schema_version", "publication_key", "extraction_date", "quotes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0" },
    "publication_key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "extraction_date": { "type": "string", "format": "date" },
    "extraction_model": { "type": "string" },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["card_id", "quote", "locator"],
        "additionalProperties": false,
        "properties": {
          "card_id": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
