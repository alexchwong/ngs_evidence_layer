__pycache__/
*.pyc
.env/
.venv/
venv/

# Private operator inputs and ingestion state. Only release artefacts under output/
# are committed.
/input/
/pdf/
/work/
/quarantine/
/archive/
/accept/
/curation/
/temp/
/evidence/
/runs/

# Working files from a retrieval session. The rendered block is the deliverable;
# the intermediate JSON is not worth keeping.
step2.json
bundle.json
block.md

# Workflow-local user configuration. Copy the repository-shipped `.template`
# files to these paths, then customise the local copies as needed.
/workflows/categorical_v1/models.json
/workflows/categorical_v1/settings.json
/workflows/terraced_v1/models.json
/workflows/terraced_v1/questions.yaml
/workflows/terraced_v1/settings.json


# User-owned public runtime configuration. Shipped pipeline defaults remain tracked;
# copy one to another filename for machine/provider-specific model choices.
/config/settings.json
/config/pipelines/*.yaml
!/config/pipelines/self.yaml
!/config/pipelines/lmstudio.yaml
!/config/pipelines/openrouter.yaml
