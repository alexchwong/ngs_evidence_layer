{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Variant-centric prognosis proforma",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicable_disease", "prognostic_frameworks", "classification"],
  "properties": {
    "applicable_disease": {"type": "string", "minLength": 1},
    "prognostic_frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tier", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "tier": {"type": ["string", "null"], "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "classification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant", "gene", "framework_effects", "other_evidence_effect", "other_evidence_reason"],
        "properties": {
          "variant": {"type": "string", "minLength": 1},
          "gene": {"type": "string", "minLength": 1},
          "framework_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["framework", "effect", "reason"],
              "properties": {
                "framework": {"type": "string", "minLength": 1},
                "effect": {"enum": ["favorable", "adverse", "neutral"]},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "other_evidence_effect": {"enum": ["favorable", "adverse", "neutral", "no_evidence"]},
          "other_evidence_reason": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
