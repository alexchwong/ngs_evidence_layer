{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provisional_disease",
    "morphologic_diagnosis_origin",
    "patient_age",
    "bootstrap_cmcs",
    "variants",
    "detected_variants_summary",
    "ngs_result_completeness",
    "ngs_no_variants_detected",
    "case_facts"
  ],
  "properties": {
    "provisional_disease": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis_status": {
      "type": "string",
      "enum": ["new", "progress"]
    },
    "morphologic_diagnosis_origin": {
      "type": "string",
      "enum": ["supplied", "inferred"]
    },
    "patient_age": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "bootstrap_cmcs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "gene",
          "description",
          "event_type",
          "vaf"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "gene": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "enum": [
              "sequence_variant",
              "fusion",
              "copy_number",
              "structural_variant",
              "other",
              "unknown"
            ]
          },
          "vaf": {
            "type": ["string", "null"],
            "minLength": 1
          }
        }
      }
    },
    "detected_variants_summary": {
      "type": "string",
      "minLength": 1
    },
    "ngs_result_completeness": {
      "type": "string",
      "enum": ["complete", "incomplete"]
    },
    "ngs_no_variants_detected": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]+$",
        "minLength": 1
      }
    },
    "case_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "kind", "value"],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
