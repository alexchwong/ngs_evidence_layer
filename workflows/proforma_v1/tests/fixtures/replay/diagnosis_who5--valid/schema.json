{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_disease",
    "diagnosis",
    "variants",
    "diagnostic_effect",
    "reason"
  ],
  "properties": {
    "schema_disease": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostic_effect": {
      "type": "string",
      "enum": [
        "unchanged",
        "refined",
        "superseded"
      ]
    }
  }
}
