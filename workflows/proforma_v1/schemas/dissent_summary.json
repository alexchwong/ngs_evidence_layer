{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summaries"],
  "properties": {
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_issue_ids",
          "statement",
          "concern_critique",
          "decision_and_basis"
        ],
        "properties": {
          "source_issue_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "statement": {"type": "string", "minLength": 1},
          "concern_critique": {"type": "string", "minLength": 1},
          "decision_and_basis": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
