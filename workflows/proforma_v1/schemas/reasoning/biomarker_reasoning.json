{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["domain", "variant_assessments"], "properties": {
    "domain": {"const": "biomarker"},
    "variant_assessments": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["variant_id", "status", "reason", "reasoning"], "properties": {
        "variant_id": {"type": "string", "minLength": 1}, "status": {"enum": ["mrd_marker", "not_mrd_marker"]},
        "reason": {"type": "string", "minLength": 1}, "reasoning": {"type": "array", "items": {"$ref": "#/$defs/reasoningPoint"}}
      }}}
  },
  "$defs": {"reasoningPoint": {"type": "object", "additionalProperties": false, "required": ["rule", "case_fact_ids", "variant_ids", "assessment", "supports_conclusion", "reason"], "properties": {"rule": {"type": "string", "minLength": 1}, "case_fact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "variant_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "assessment": {"enum": ["met", "not_met", "unknown"]}, "supports_conclusion": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}}}}
}
