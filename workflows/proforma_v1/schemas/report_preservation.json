{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audits"
  ],
  "properties": {
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "preserved",
          "issue"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "preserved": {
            "type": "boolean"
          },
          "issue": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      }
    }
  }
}
