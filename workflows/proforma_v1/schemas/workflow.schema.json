{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflow_id",
    "steps",
    "evidence_policies"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_root": {
      "type": "string",
      "minLength": 1
    },
    "self_groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy"
        ],
        "properties": {
          "strategy": {
            "enum": [
              "batch_ready"
            ]
          }
        }
      }
    },
    "evidence_policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment",
          "audit",
          "adjudication"
        ],
        "properties": {
          "assignment": {
            "$ref": "#/$defs/evidencePass"
          },
          "audit": {
            "$ref": "#/$defs/evidencePass"
          },
          "adjudication": {
            "$ref": "#/$defs/evidencePass"
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "evidencePass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "prompt"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "executorToggle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "yaml",
            "json",
            "text"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "assembly": {
          "type": "object"
        }
      }
    },
    "reviewVerdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pass_values": {
          "type": "array",
          "minItems": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "path",
            "pass_values"
          ],
          "not": {
            "required": [
              "predicate"
            ]
          }
        },
        {
          "required": [
            "predicate"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "pass_values"
                ]
              }
            ]
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "verdict",
        "on_pass",
        "on_fail"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "$ref": "#/$defs/reviewVerdict"
        },
        "on_pass": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "continue": {
              "const": true
            }
          }
        },
        "on_fail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retry_target": {
              "type": "boolean"
            },
            "route_to": {
              "type": "string",
              "minLength": 1
            },
            "feedback": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "as"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "as": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "max_cycles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "exhausted": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "enum": [
                    "stop",
                    "suppress",
                    "continue_with_dissent",
                    "route_to"
                  ]
                },
                "route_to": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "retry_target",
                "max_cycles"
              ]
            },
            {
              "required": [
                "route_to"
              ]
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "model",
            "transform",
            "evidence_review",
            "evidence_adjudication",
            "render/report"
          ]
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule"
            ]
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "transform"
                ]
              }
            ]
          }
        },
        "transform": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "object"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "timing"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "timing": {
              "enum": [
                "blocking",
                "deferred"
              ]
            },
            "cards": {
              "type": "object"
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "match_passes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "owner_assignment": {
              "type": "boolean"
            },
            "rescue_match_passes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider_handler": {
              "type": "string"
            },
            "provider_group": {
              "type": "string"
            },
            "self_handler": {
              "type": "string"
            },
            "self_group": {
              "type": "string"
            },
            "self_mode": {
              "enum": [
                "handoff",
                "deterministic",
                "skip"
              ]
            },
            "provider": {
              "$ref": "#/$defs/executorToggle"
            },
            "self": {
              "$ref": "#/$defs/executorToggle"
            }
          }
        },
        "barrier_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
