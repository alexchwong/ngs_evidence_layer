{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "default_reviewed_v2 clinical owner coherence packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["patient_findings", "propositions"],
  "properties": {
    "authority": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "patient_findings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "starting_morphologic_diagnosis": {"type": ["string", "null"]},
    "deterministic_flags": {"type": "array", "items": {"type": "object"}},
    "authoritative_diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who5", "icc", "applicable_disease"],
      "properties": {
        "who5": {"type": ["string", "null"]},
        "icc": {"type": ["string", "null"]},
        "applicable_disease": {"type": ["string", "null"]}
      }
    },
    "propositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/proposition"}
    }
  },
  "oneOf": [
    {"required": ["authority", "starting_morphologic_diagnosis", "deterministic_flags"]},
    {"required": ["domain", "authoritative_diagnosis"]}
  ],
  "$defs": {
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "reason"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"type": ["string", "number", "boolean", "null"]},
        "reason": {"type": ["string", "null"]},
        "derived": {"type": "boolean"}
      }
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "conclusion", "premises", "integrative_reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(PX|TX|MRD|GL|DX-WHO|DX-ICC):"
        },
        "variant": {"type": "string", "minLength": 1},
        "gene": {"type": ["string", "null"]},
        "observed_event_type": {"type": ["string", "null"]},
        "observed_vaf": {"type": ["string", "number", "null"]},
        "eligibility": {"type": ["string", "null"]},
        "conclusion": {"type": ["string", "number", "boolean", "null"]},
        "premises": {
          "type": "array",
          "items": {"$ref": "#/$defs/premise"}
        },
        "integrative_reason": {"type": ["string", "null"]}
      }
    }
  }
}