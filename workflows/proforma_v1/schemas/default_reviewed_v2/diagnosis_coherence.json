{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "status"],
        "properties": {
          "authority": {"enum": ["who1", "who2", "icc"]},
          "status": {"enum": ["pass", "revision_required"]},
          "scope": {"enum": ["reason", "conclusion"]},
          "issues": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
