{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "default_reviewed_v2 addressable owner disputes",
  "type": "object",
  "additionalProperties": false,
  "required": ["disputes"],
  "properties": {
    "disputes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposition_id",
          "premise",
          "defect_type",
          "finding_quote",
          "absent_finding",
          "related_proposition_id",
          "criticism"
        ],
        "properties": {
          "proposition_id": {"type": "string", "minLength": 1},
          "premise": {"type": "string", "minLength": 1},
          "defect_type": {
            "type": "string",
            "enum": [
              "contradicts_supplied_finding",
              "asserts_unsupplied_finding",
              "rule_restriction_unmet",
              "internal_contradiction",
              "wrong_disease_context",
              "background_knowledge_error"
            ]
          },
          "finding_quote": {"type": ["string", "null"]},
          "absent_finding": {"type": ["string", "null"]},
          "related_proposition_id": {"type": ["string", "null"]},
          "criticism": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
