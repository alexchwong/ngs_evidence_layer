{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed clinical MRD proforma",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicable_disease", "classification"],
  "properties": {
    "applicable_disease": {"type": "string", "minLength": 1},
    "classification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant", "gene", "mrd_status", "reason"],
        "properties": {
          "variant": {"type": "string", "minLength": 1},
          "gene": {"type": "string", "minLength": 1},
          "mrd_status": {"enum": ["mrd_marker", "not_mrd_marker"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
