{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed clinical treatment proforma",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicable_disease", "classification"],
  "properties": {
    "applicable_disease": {"type": "string", "minLength": 1},
    "classification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant", "gene", "treatment_category", "reason"],
        "properties": {
          "variant": {"type": "string", "minLength": 1},
          "gene": {"type": "string", "minLength": 1},
          "treatment_category": {"enum": ["drug_target", "drug_sensitive", "drug_resistant", "no_drug_implication"]},
          "therapy": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
