{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "conclusions"],
  "properties": {
    "owner": {"enum": ["who1", "who2", "icc", "prognosis", "treatment", "biomarker", "germline"]},
    "conclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conclusion_id", "atoms"],
        "properties": {
          "conclusion_id": {"type": "string", "pattern": "^C[0-9]{3}$"},
          "atoms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_fragment_id", "text", "evidence_class"],
              "properties": {
                "source_fragment_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
                "text": {"type": "string", "minLength": 1},
                "evidence_class": {"enum": ["case_fact", "clinical_application", "literature_rule"]}
              }
            }
          }
        }
      }
    }
  }
}
