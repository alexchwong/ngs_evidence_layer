{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "terraced-v6 stage asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "version",
    "type",
    "output"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "type": {
      "enum": [
        "model",
        "domain_proforma",
        "batch",
        "compound"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "yaml",
            "json"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extra_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "therapy_buckets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "solitary_buckets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "multi_row": {
      "type": "boolean"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule"
        ],
        "additionalProperties": true,
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reportability": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "integer",
          "minimum": 0
        },
        "serialization": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
