{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PTBG owner proforma with a named score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "prognostic_score"
  ],
  "properties": {
    "classification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant",
          "bucket",
          "reason"
        ],
        "properties": {
          "variant": {
            "type": "string",
            "minLength": 1
          },
          "bucket": {
            "type": "string",
            "minLength": 1
          },
          "therapy": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prognostic_score": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "result",
            "reason"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
